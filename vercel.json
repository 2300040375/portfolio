{
  "version": 2,
  "builds": [
    { "src": "api/send-email.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "portfolio-project/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/send-email", "dest": "/api/send-email.js" },
    { "src": "/", "dest": "/portfolio-project/index.html" },
    { "src": "/portfolio-project/(.*)", "dest": "/portfolio-project/$1" }
  ]
}